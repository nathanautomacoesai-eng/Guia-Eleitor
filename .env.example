# Chave gratuita da API do Portal da Transparencia.
# Cadastre seu e-mail em: https://www.portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# Voce recebera a chave por e-mail e deve colar aqui.
PORTAL_TRANSPARENCIA_API_KEY=cole_sua_chave_aqui

# Connection string do Postgres do seu projeto Supabase.
# Pegue em: Project Settings > Database > Connection string > URI
# (use a versao "Session pooler", compativel com IPv4 - ver README)
DATABASE_URL=postgresql://postgres.xxxxxxxx:sua_senha_aqui@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase Storage - onde os PDFs das propostas de governo ficam guardados
# (para funcionar mesmo quando o site estiver publicado na internet).
# Pegue em: Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role key (SECRETA - Project Settings > API > Project API keys > service_role)
SUPABASE_SERVICE_ROLE_KEY=cole_sua_service_role_key_aqui
SUPABASE_STORAGE_BUCKET=propostas-governo
